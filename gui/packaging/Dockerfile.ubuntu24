FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl build-essential pkg-config python3 python3-venv \
    python3-dev libgl1-mesa-dev libx11-dev libxkbcommon-dev \
    libfontconfig1-dev libfreetype-dev libxcb1-dev libxrandr-dev \
    libxkbcommon-x11-0 libxcb-xkb1 \
    libxi-dev libxcursor-dev libwayland-dev libwayland-egl1 libegl1 libgl1 libfuse2t64 \
    desktop-file-utils file xvfb xauth imagemagick \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/root/.cargo/bin:${PATH}"
